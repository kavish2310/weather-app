# Flask Configuration
FLASK_SECRET_KEY=change_this_to_a_random_secure_secret_key_in_production
FLASK_DEBUG=True
LOG_LEVEL=INFO

# Database Connection (SQLite default, can be changed to postgresql://user:password@localhost/weather)
DATABASE_URL=sqlite:///data/weather.db

# Cache & Rate Limiting
CACHE_TIMEOUT=300
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
